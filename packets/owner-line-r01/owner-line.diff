+def owner_named(value, registry):
+    """True if an Owner line names its owner. The usual form starts with the
+    agent ("Copilot (2026-11-20, ...)"). Lines written before that form was
+    checked, such as "sponsor's GitHub Copilot agent", are accepted when they
+    name exactly one owner agent and no other agent; earlier Owner lines are
+    never rewritten, so the check must not demand it."""
+    owners = agents.owners(registry)
+    first = re.match(r"[A-Za-z]+", value)
+    if first and first.group(0).lower() in owners:
+        return True
+    words = {w.lower() for w in re.findall(r"[A-Za-z]+", value)}
+    named = words & set(registry["channels"])
+    return len(named) == 1 and named <= set(owners)
+
+
