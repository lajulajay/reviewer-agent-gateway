+    || { print -u2 "budget $output: expected refusal 79, got $code"; exit 1; }
+  jq -e --arg p "$pattern" '.reason | contains($p)' "$broot/.collab/${${output%.md}%.json}.diagnostic.json" >/dev/null \
+    || { print -u2 "budget $output: reason lacks '$pattern'"; exit 1; }
+}
