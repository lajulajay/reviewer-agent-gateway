diff --git a/docs-check.py b/docs-check.py
index 9cc87dd..4a76507 100755
--- a/docs-check.py
+++ b/docs-check.py
@@ -482,6 +482,18 @@ def record(repo):
         rel = str(f.relative_to(repo))
         if rel in legacy:
             continue
+        if f.name.endswith(".extracted.md"):
+            # An owner's extraction of a failed invocation's review text (not a
+            # review): kept only beside that invocation's diagnostic, with a
+            # sidecar whose first field is the extraction's SHA-256.
+            stem = f.name[: -len(".extracted.md")]
+            side = f.with_name(f.name + ".sha256")
+            digest = side.read_text().split() if side.is_file() else []
+            if not (f.with_name(stem + ".diagnostic.json").is_file() and digest
+                    and digest[0] == hashlib.sha256(f.read_bytes()).hexdigest()):
+                errors.append(f".collab: {rel} is an extraction without a matching "
+                              f"{stem}.diagnostic.json and checksum sidecar")
+            continue
         if not is_review_artifact(f):
             errors.append(f".collab: {rel} is not a recognizable review artifact")
         elif str(f.resolve()) not in indexed:
diff --git a/tests/test_docs_check.py b/tests/test_docs_check.py
index f22a272..18e991d 100644
--- a/tests/test_docs_check.py
+++ b/tests/test_docs_check.py
@@ -225,6 +225,29 @@ class DocsCheckTest(unittest.TestCase):
         code, out = self.record()
         self.assertEqual(code, 0, out)
 
+    def test_failed_invocation_extraction(self):
+        self.f.workstream(GOOD_ROWS)
+        collab = self.f.repo / ".collab"
+        text = "F1 [major]: extracted text\nVERDICT: REJECT\n"
+        ext = collab / "gemini-x-r09.extracted.md"
+        ext.write_text(text)
+        side = collab / "gemini-x-r09.extracted.md.sha256"
+        # no diagnostic yet: flagged
+        side.write_text(hashlib.sha256(text.encode()).hexdigest() + "  .collab/gemini-x-r09.extracted.md\n")
+        self.assertIn("gemini-x-r09.extracted.md is an extraction without a matching", self.record()[1])
+        (collab / "gemini-x-r09.diagnostic.json").write_text('{"exit": 70}\n')
+        code, out = self.record()
+        self.assertEqual(code, 0, out)
+        # wrong or missing checksum: flagged
+        side.write_text("0" * 64 + "\n")
+        self.assertIn("gemini-x-r09.extracted.md is an extraction without a matching", self.record()[1])
+        side.unlink()
+        self.assertIn("gemini-x-r09.extracted.md is an extraction without a matching", self.record()[1])
+        # any other unrecognized file is still flagged
+        side.write_text(hashlib.sha256(text.encode()).hexdigest() + "\n")
+        (collab / "gemini-x-r09.notes.md").write_text("# notes\n")
+        self.assertIn("gemini-x-r09.notes.md is not a recognizable review artifact", self.record()[1])
+
     def test_newly_staged_artifact_passes_before_commit(self):
         self.f.workstream(GOOD_ROWS)
         self.f.adopt()
